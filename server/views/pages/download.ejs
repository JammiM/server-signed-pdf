<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head'); %>
  </head>
  <body class="container">
    <header><%- include('../partials/header'); %></header>
    <main>
      <div class="jumbotron">
        <a href="<%= downloadUrl %>" target="_blank">Download signed PDF</a>
        <h3>Files are deleted after 10 minutes</h3>
        <p>
          The signed PDF will be deleted after 10 minutes.
          <a href='<%-  request.protocol + "://" + request.get("host") %>/api'
            >Click here to go back to pdf upload page</a
          >
        </p>
        <object
          data="<%= downloadUrl %>"
          type="application/pdf"
          width="100%"
          height="100%"
        >
          <iframe
            src="<%= downloadUrl %>"
            width="100%"
            height="100%"
            style="border: none"
          >
            <p>
              Your browser does not support PDF viewing.
              <a href="<%= downloadUrl %>">Download the PDF</a>.
            </p>
          </iframe>
        </object>
      </div>
    </main>
    <footer><%- include('../partials/footer'); %></footer>
  </body>
</html>
