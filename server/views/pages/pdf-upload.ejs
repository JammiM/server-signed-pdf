<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head'); %>
  </head>
  <body class="l-application l-site u-align--center" role="presentation">
    <%- include('../partials/header'); %>

    <main class="l-main">
      <div class="p-card u-vertically-center" style="min-height: 500px">
        <div class="p-card">
          <form
            autocomplete="off"
            method="post"
            action='<%-  request.protocol + "://" + request.get("host") %>/api/upload_pdf'
            enctype="multipart/form-data"
          >
            <p>Max file upload is 5 MB</p>
            <label for="pdf-to-sign">Choose a pdf to sign:</label>

            <input
              type="file"
              id="pdf-to-sign"
              name="pdf-to-sign"
              accept=".pdf"
            />
            <button id="submitBtn" type="submit">submit</button>
          </form>
        </div>
      </div>
    </main>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const fileInput = document.getElementById("pdf-to-sign");
        const submitBtn = document.getElementById("submitBtn");

        fileInput.files.length = 0;
        submitBtn.disabled = true;

        fileInput.addEventListener("change", () => {
          if (fileInput.files.length > 0) {
            submitBtn.disabled = false;
          } else {
            submitBtn.disabled = true;
          }
        });
      });
    </script>

    <%- include('../partials/footer'); %>
  </body>
</html>
